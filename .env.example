# Copy to .env and fill in. Never commit .env.
# `chmod 600 .env` after editing.

# IBKR Flex Query — Phase 1
IBKR_FLEX_TOKEN=
IBKR_FLEX_QUERY_ID=

# News ingestion — Phase 2
EXA_API_KEY=

# Scoring & red team — Phase 3-4
