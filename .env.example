# Copy to .env and fill in. Never commit .env.
# `chmod 600 .env` after editing.

# IBKR Flex Query — Phase 1
IBKR_FLEX_TOKEN=
IBKR_FLEX_QUERY_ID=

# News ingestion — Phase 2 / W2 sources
# Generic current-web research is handled by Codex GPT-5.5 native web search in
# the Hermes/VPS runner prompts, not by an application-held search API key.
# SEMANTIC_SCHOLAR_API_KEY enables the literature poll (bucket #10) — a plain
# REST key (sent as x-api-key), no OAuth, so it never logs out on a headless host
# (replaces Scite for #10). FMP_API_KEY enables financial snapshots
# (#4/#7/#12 + dashboard). EXA_API_KEY (search) and SCITE_API_KEY (literature)
# are legacy fallbacks. With none set, run the pipeline offline via
# `--from-file` fixtures.
SEMANTIC_SCHOLAR_API_KEY=
SCITE_API_KEY=
FMP_API_KEY=
EXA_API_KEY=
# TipRanks analyst targets use the local Camoufox service bundled in Hermes.
# Defaults normally need no changes. The request delay keeps the weekly scrape
# deliberately sequential and low-rate.
# TIPRANKS_BROWSER_URL=http://127.0.0.1:9377
# TIPRANKS_BROWSER_COMMAND=node /opt/hermes/node_modules/@askjo/camofox-browser/server.js
# TIPRANKS_BROWSER_START_TIMEOUT_SECONDS=35
# TIPRANKS_RENDER_WAIT_SECONDS=3
# TIPRANKS_REQUEST_DELAY_SECONDS=2
# SEC EDGAR (financials primary, ahead of FMP) — no API key; SEC's fair-access
# policy wants a descriptive User-Agent with real contact info.
SEC_EDGAR_USER_AGENT=sma-monitor (contact: you@example.com)
# PubMed (NCBI E-utilities) — biomed-literature primary; works without a key.
# Optional NCBI_API_KEY raises the rate limit (3 -> 10 req/s).
NCBI_API_KEY=

# LLM (scorer, red team, digest narrative, thesis-drift decisions)
# Codex CLI is the only live LLM backend. Authenticate Codex locally on Hermes
# with a ChatGPT/Codex subscription login and set CODEX_HOME if using a service
# account directory. When Codex is unavailable, the app falls back to its
# deterministic heuristic paths.
# ANTHROPIC_API_KEY is legacy/optional (the Anthropic SDK has been removed from
# the code) — leave blank unless you wire an Anthropic provider back in.
ANTHROPIC_API_KEY=
# Codex failure emails are rate-limited per stage/error to avoid alert storms.
# SMA_CODEX_ALERT_COOLDOWN_S=900
# Optional Codex overrides (see llm/codex_client.py):
# SMA_CODEX_BIN=codex
# SMA_CODEX_MODEL=
# CODEX_HOME=
#
# W9 throughput tiering + concurrency (see llm/throughput.py). All optional.
# Per-stage model/effort let operators tune Codex CLI calls. Defaults are
# medium across scorer/red_team/decision/digest/chat so the app avoids slow
# high/xhigh calls unless a stage override is explicitly set. Stage overrides
# win over the global SMA_CODEX_MODEL / SMA_CODEX_EFFORT.
# SMA_CODEX_EFFORT=                 # global reasoning effort (low|medium|high)
# SMA_CODEX_EFFORT_SCORER=medium
# SMA_CODEX_EFFORT_RED_TEAM=medium
# SMA_CODEX_EFFORT_DECISION=medium
# SMA_CODEX_EFFORT_DRAFT_THESIS=medium
# SMA_CODEX_EFFORT_DIGEST=medium
# SMA_CODEX_EFFORT_CHAT=medium
# SMA_CODEX_MODEL_SCORER=           # e.g. a cheaper/faster slug for triage
# SMA_CODEX_MODEL_DECISION=         # e.g. a deeper slug for synthesis
# SMA_CODEX_MODEL_DRAFT_THESIS=      # researched preliminary-thesis generation
# Concurrent LLM calls per per-item loop (clamped 1..16; default 4):
# SMA_LLM_CONCURRENCY=4
# Bounded retry with exponential backoff on rate-limited (429) execs:
# SMA_LLM_MAX_RETRIES=4
# SMA_LLM_BACKOFF_BASE_S=2.0
# SQLite lock wait for the test-only SQLite sandbox (ms; default 30000):
# SMA_SQLITE_BUSY_TIMEOUT_MS=30000

# Alerts / email — Phase 5 + the W7 morning thesis email
# Legacy SMTP transport. Used only when RESEND_API_KEY (below) is NOT set.
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Resend — preferred email transport for the daily 9 AM risk brief (and, when
# set, all alert/digest mail). Paste your key into RESEND_API_KEY to go live;
# it supersedes the SMTP block above. RESEND_EMAIL_FROM must be a sender on a
# domain you have verified in Resend (e.g. "AI CRO Risk Desk <risk@yourdomain.com>").
# onboarding@resend.dev only delivers to your own Resend account email — switch
# to a verified domain before relying on multi-recipient delivery.
# RESEND_EMAIL_TO is a comma-separated recipient list.
RESEND_API_KEY=
RESEND_EMAIL_FROM=AI CRO Risk Desk <onboarding@resend.dev>
RESEND_EMAIL_TO=bhavn008@gmail.com,bhavya20051@gmail.com

# API / dashboard — W5/W6 (optional)
# Comma-separated extra CORS origins for the dev frontend; defaults to the
# Vite dev server. Not needed when the API serves the built bundle same-origin.
# SMA_API_CORS_ORIGINS=http://localhost:5173
# Override the static bundle location (default: <repo>/frontend/dist).
# SMA_FRONTEND_DIST=

# Runtime
# Deployment role:
# - dashboard: Replit UI/API only; queues Hermes runner work, no scheduler/email/Codex.
# - runner: Hermes/VPS CLI jobs; Codex + Resend live here.
# - combined: local/dev legacy mode where API also starts background loops.
SMA_DEPLOYMENT_ROLE=dashboard
# Database backend. App runtime is Turso-only; there is no local SQLite fallback.
# TURSO_DATABASE_URL=libsql://your-db-your-org.turso.io
# TURSO_AUTH_TOKEN=
DATA_ROOT=./data
LOG_LEVEL=INFO
