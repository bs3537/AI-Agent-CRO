# Alerts — Phase 5
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Runtime
DATA_ROOT=./data
LOG_LEVEL=INFO
