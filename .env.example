# Copy to .env and fill in. Never commit .env.
# `chmod 600 .env` after editing.

# IBKR Flex Query — Phase 1
IBKR_FLEX_TOKEN=
IBKR_FLEX_QUERY_ID=

# News ingestion — Phase 2 / W2 sources
# Brave is the primary news source (replaces Exa); set BRAVE_SEARCH_API_KEY to
# go live. SEMANTIC_SCHOLAR_API_KEY enables the literature poll (bucket #10) —
# a plain REST key (sent as x-api-key), no OAuth, so it never logs out on a
# headless host (replaces Scite for #10). FMP_API_KEY enables financial
# snapshots (#4/#7/#12 + dashboard). EXA_API_KEY (search) and SCITE_API_KEY
# (literature) are legacy fallbacks. With none set, run the pipeline offline
# via `--from-file` fixtures.
BRAVE_SEARCH_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
SCITE_API_KEY=
FMP_API_KEY=
EXA_API_KEY=
# SEC EDGAR (financials primary, ahead of FMP) — no API key; SEC's fair-access
# policy wants a descriptive User-Agent with real contact info.
SEC_EDGAR_USER_AGENT=sma-monitor (contact: you@example.com)
# PubMed (NCBI E-utilities) — biomed-literature primary; works without a key.
# Optional NCBI_API_KEY raises the rate limit (3 -> 10 req/s).
NCBI_API_KEY=

# LLM (scorer, red team, digest narrative, thesis-drift decisions)
# Auth is the OpenAI Codex CLI subscription login on the HOST — run
# `codex login` (or `codex login --device-auth` on a headless VM) once; no
# API key goes here. With no Codex login the pipeline falls back to its
# deterministic heuristics. ANTHROPIC_API_KEY is legacy/optional (the
# Anthropic SDK has been removed from the code) — leave blank unless you
# wire an Anthropic provider back in.
ANTHROPIC_API_KEY=
# Optional Codex overrides (see llm/codex_client.py):
# SMA_CODEX_BIN=codex
# SMA_CODEX_MODEL=
# CODEX_HOME=

# Alerts / email — Phase 5 + the W7 morning thesis email
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# API / dashboard — W5/W6 (optional)
# Comma-separated extra CORS origins for the dev frontend; defaults to the
# Vite dev server. Not needed when the API serves the built bundle same-origin.
# SMA_API_CORS_ORIGINS=http://localhost:5173
# Override the static bundle location (default: <repo>/frontend/dist).
# SMA_FRONTEND_DIST=

# Runtime
DATA_ROOT=./data
LOG_LEVEL=INFO
