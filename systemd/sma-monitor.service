# Install: copy to /etc/systemd/system/sma-monitor.service
# Then:    sudo systemctl daemon-reload && sudo systemctl enable --now sma-monitor
# Logs:    journalctl -u sma-monitor -f
#
# Runs the long-lived orchestrator loop. The loop sleeps until the next daily
# firing — 9 AM ET (thesis-drift email), 6 PM ET (collect+decide), or 9 PM ET
# (dispatch digest) — and runs the appropriate cycle. Weekends are skipped.
# ET is resolved via Python zoneinfo, so this works on any systemd version
# (unlike the OnCalendar timezone suffix the *.timer units use).
#
# This run-loop is the ALTERNATIVE to the per-firing timer units
# (sma-{thesis-email,collect,dispatch}.timer). Enable EITHER this service OR
# the three timers — not both, or each firing would run twice.
#
# For cron-based deployments use the snippet from
# `python -m sma_monitor.orchestrator install-cron` instead of this unit.

[Unit]
Description=SMA news/event monitoring agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sma
Group=sma
WorkingDirectory=/opt/sma-monitor
EnvironmentFile=/opt/sma-monitor/.env
ExecStartPre=/opt/sma-monitor/.venv/bin/python -m sma_monitor
ExecStart=/opt/sma-monitor/.venv/bin/python -m sma_monitor.orchestrator run
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/sma-monitor/data
PrivateTmp=true

[Install]
WantedBy=multi-user.target
